<Window x:Class="InfiniteTerminal.UpdateReadyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="更新已就绪" Width="500" Height="268"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False">
    <Border Margin="18" CornerRadius="14" Background="#12151B"
            BorderBrush="#5B4A31" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.55" Color="#000000"/>
        </Border.Effect>
        <Grid Margin="26,22,26,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Border Width="44" Height="44" CornerRadius="22" Background="#26311F"
                            BorderBrush="#617A48" BorderThickness="1">
                        <TextBlock Text="✓" Foreground="#A9C982" FontFamily="Segoe UI"
                                   FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="14,2,0,0">
                        <TextBlock Text="更新已准备好" Foreground="#F2EADB"
                                   FontFamily="Microsoft YaHei UI" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock x:Name="VersionText" Text="V1.71" Foreground="#A9C982"
                                   FontFamily="Consolas" FontSize="11" Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>
                <Button Content="✕" Width="28" Height="28" HorizontalAlignment="Right"
                        VerticalAlignment="Top" Background="Transparent" Foreground="#8D8679"
                        BorderThickness="0" FontSize="13" Cursor="Hand" Click="Later_Click"/>
            </Grid>

            <Border Grid.Row="1" Height="1" Background="#292720" Margin="0,18,0,17"/>

            <StackPanel Grid.Row="2">
                <TextBlock Text="更新包已下载并通过 SHA256 校验。" Foreground="#D8D0C2"
                           FontFamily="Microsoft YaHei UI" FontSize="12"/>
                <TextBlock Text="点击“立即更新”后，软件会先关闭，替换文件后自动重新打开。"
                           Foreground="#938B7D" FontFamily="Microsoft YaHei UI" FontSize="11"
                           Margin="0,7,0,0" TextWrapping="Wrap"/>
                <TextBlock Text="角色卡、账本和终端数据不会被覆盖。"
                           Foreground="#6F6A60" FontFamily="Microsoft YaHei UI" FontSize="10.5"
                           Margin="0,9,0,0"/>
            </StackPanel>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="稍后" Width="86" Height="32" Margin="0,0,10,0"
                        Background="#23262D" Foreground="#CFC6B7" BorderBrush="#4A4032"
                        BorderThickness="1" Cursor="Hand" Click="Later_Click"/>
                <Button Content="立即更新" Width="104" Height="32"
                        Background="#C9A35F" Foreground="#171410" BorderThickness="0"
                        FontWeight="SemiBold" Cursor="Hand" Click="Update_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
