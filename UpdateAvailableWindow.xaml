<Window x:Class="InfiniteTerminal.UpdateAvailableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="发现新版本" Width="540" Height="360"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        ShowInTaskbar="False">
    <Border Margin="18" CornerRadius="14" Background="#12151B"
            BorderBrush="#5B4A31" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.55" Color="#000000"/>
        </Border.Effect>
        <Grid Margin="26,22,26,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Border Width="42" Height="42" CornerRadius="10" Background="#2A2318"
                            BorderBrush="#6A5636" BorderThickness="1">
                        <TextBlock Text="↑" Foreground="#D8B878" FontFamily="Segoe UI"
                                   FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="13,1,0,0">
                        <TextBlock Text="发现新版本" Foreground="#F2EADB"
                                   FontFamily="Microsoft YaHei UI" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock x:Name="VersionText" Text="V1.79" Foreground="#D8B878"
                                   FontFamily="Consolas" FontSize="11" Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>
                <Button Content="✕" Width="28" Height="28" HorizontalAlignment="Right"
                        VerticalAlignment="Top" Background="Transparent" Foreground="#8D8679"
                        BorderThickness="0" FontSize="13" Cursor="Hand" Click="Later_Click"/>
            </Grid>

            <Border Grid.Row="1" Height="1" Background="#292720" Margin="0,18,0,16"/>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Background="#181B21" BorderBrush="#302C24" BorderThickness="1"
                        CornerRadius="7" Padding="12,9">
                    <StackPanel>
                        <TextBlock Text="当前版本" Foreground="#716B61" FontSize="10"
                                   FontFamily="Microsoft YaHei UI"/>
                        <TextBlock x:Name="CurrentText" Text="V1.78" Foreground="#B9B0A1"
                                   FontFamily="Consolas" FontSize="17" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <TextBlock Grid.Column="1" Text="→" Foreground="#C9A35F" FontSize="20"
                           VerticalAlignment="Center" Margin="14,0"/>
                <Border Grid.Column="2" Background="#1D1B15" BorderBrush="#6A5636" BorderThickness="1"
                        CornerRadius="7" Padding="12,9">
                    <StackPanel>
                        <TextBlock Text="最新版本" Foreground="#A58C60" FontSize="10"
                                   FontFamily="Microsoft YaHei UI"/>
                        <TextBlock x:Name="LatestText" Text="V1.79" Foreground="#E2C486"
                                   FontFamily="Consolas" FontSize="17" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <ScrollViewer Grid.Row="3" Margin="0,15,0,0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="更新内容" Foreground="#8D8679" FontSize="10.5"
                               FontFamily="Microsoft YaHei UI" Margin="0,0,0,6"/>
                    <TextBlock x:Name="NotesText" Foreground="#B9B0A1" FontSize="11"
                               FontFamily="Microsoft YaHei UI" TextWrapping="Wrap" LineHeight="19"/>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="4" Margin="0,14,0,0">
                <TextBlock Text="下载完成后会校验并关闭软件更新" Foreground="#5F5A51"
                           FontSize="10.5" FontFamily="Microsoft YaHei UI" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="稍后" Width="86" Height="32" Margin="0,0,10,0"
                            Background="#23262D" Foreground="#CFC6B7" BorderBrush="#4A4032"
                            BorderThickness="1" Cursor="Hand" Click="Later_Click"/>
                    <Button Content="下载更新" Width="104" Height="32"
                            Background="#C9A35F" Foreground="#171410" BorderThickness="0"
                            FontWeight="SemiBold" Cursor="Hand" Click="Download_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
