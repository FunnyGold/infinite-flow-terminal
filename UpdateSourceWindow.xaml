<Window x:Class="InfiniteTerminal.UpdateSourceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择下载源" Width="520" Height="360"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="SourceCard" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Card" CornerRadius="9" Background="#171A20"
                                BorderBrush="#302C24" BorderThickness="1" Padding="14,12">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="#C9A35F"/>
                                <Setter TargetName="Card" Property="Background" Value="#211D15"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="#6A5636"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="18" CornerRadius="14" Background="#12151B"
            BorderBrush="#5B4A31" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.55" Color="#000000"/>
        </Border.Effect>
        <Grid Margin="26,22,26,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Border Width="40" Height="40" CornerRadius="10" Background="#2A2318"
                            BorderBrush="#6A5636" BorderThickness="1">
                        <TextBlock Text="⇣" Foreground="#D8B878" FontFamily="Segoe UI"
                                   FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="13,1,0,0">
                        <TextBlock Text="选择下载源" Foreground="#F2EADB"
                                   FontFamily="Microsoft YaHei UI" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock Text="优先从所选源下载，不可用时自动切换" Foreground="#8D8679"
                                   FontFamily="Microsoft YaHei UI" FontSize="10.5" Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>
                <Button Content="✕" Width="28" Height="28" HorizontalAlignment="Right"
                        VerticalAlignment="Top" Background="Transparent" Foreground="#8D8679"
                        BorderThickness="0" FontSize="13" Cursor="Hand" Click="Cancel_Click"/>
            </Grid>

            <Border Grid.Row="1" Height="1" Background="#292720" Margin="0,18,0,14"/>

            <StackPanel Grid.Row="2">
                <RadioButton x:Name="GiteeRadio" GroupName="Source" IsChecked="True"
                             Style="{StaticResource SourceCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Gitee" Foreground="#E2C486" FontSize="15"
                                       FontFamily="Microsoft YaHei UI" FontWeight="SemiBold"/>
                            <Border Background="#2A2A1C" BorderBrush="#6A5636" BorderThickness="1"
                                    CornerRadius="4" Padding="6,1" Margin="8,0,0,0">
                                <TextBlock Text="推荐" Foreground="#C9A35F" FontSize="9"
                                           FontFamily="Microsoft YaHei UI"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="国内访问较快，适合直接下载更新包" Foreground="#8D8679"
                                   FontSize="10.5" FontFamily="Microsoft YaHei UI" Margin="0,5,0,0"/>
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="GitHubRadio" GroupName="Source" Margin="0,9,0,0"
                             Style="{StaticResource SourceCard}">
                    <StackPanel>
                        <TextBlock Text="GitHub" Foreground="#D8D0C2" FontSize="15"
                                   FontFamily="Microsoft YaHei UI" FontWeight="SemiBold"/>
                        <TextBlock Text="官方源；国内网络可能较慢或连不上" Foreground="#8D8679"
                                   FontSize="10.5" FontFamily="Microsoft YaHei UI" Margin="0,5,0,0"/>
                    </StackPanel>
                </RadioButton>
            </StackPanel>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="取消" Width="82" Height="32" Margin="0,0,10,0"
                        Background="#23262D" Foreground="#CFC6B7" BorderBrush="#4A4032"
                        BorderThickness="1" Cursor="Hand" Click="Cancel_Click"/>
                <Button Content="检查更新" Width="104" Height="32"
                        Background="#C9A35F" Foreground="#171410" BorderThickness="0"
                        FontWeight="SemiBold" Cursor="Hand" Click="Continue_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
