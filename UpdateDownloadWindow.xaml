<Window x:Class="InfiniteTerminal.UpdateDownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="下载更新" Width="560" Height="300"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False">
    <Border Margin="18" CornerRadius="14" Background="#12151B"
            BorderBrush="#5B4A31" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.55" Color="#000000"/>
        </Border.Effect>
        <Grid Margin="26,22,26,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Border Width="42" Height="42" CornerRadius="10" Background="#2A2318"
                            BorderBrush="#6A5636" BorderThickness="1">
                        <TextBlock Text="∞" Foreground="#D8B878" FontFamily="Georgia"
                                   FontSize="27" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="13,2,0,0">
                        <TextBlock Text="无限流 · 角色终端" Foreground="#F2EADB"
                                   FontFamily="Microsoft YaHei UI" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="自动更新" Foreground="#8D8679"
                                   FontFamily="Microsoft YaHei UI" FontSize="11" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>
                <Button x:Name="CloseButton" Content="✕" Width="28" Height="28"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Background="Transparent" Foreground="#8D8679" BorderThickness="0"
                        FontSize="13" Cursor="Hand" Click="Cancel_Click"/>
            </Grid>

            <Border Grid.Row="1" Height="1" Background="#292720" Margin="0,18,0,17"/>

            <StackPanel Grid.Row="2">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="TitleText" Text="正在下载更新" Foreground="#F2EADB"
                               FontFamily="Microsoft YaHei UI" FontSize="15" FontWeight="SemiBold"/>
                    <Border Background="#262116" BorderBrush="#5B4A31" BorderThickness="1"
                            CornerRadius="4" Padding="7,2" Margin="9,0,0,0">
                        <TextBlock x:Name="VersionText" Text="V1.71" Foreground="#D8B878"
                                   FontFamily="Consolas" FontSize="11"/>
                    </Border>
                </StackPanel>
                <TextBlock x:Name="SubText" Text="准备下载…" Foreground="#938B7D"
                           FontFamily="Microsoft YaHei UI" FontSize="11.5" Margin="0,7,0,0"/>
                <ProgressBar x:Name="Bar" Height="10" Minimum="0" Maximum="100"
                             Margin="0,15,0,0" BorderThickness="0" Background="#242830"
                             Foreground="#C9A35F">
                    <ProgressBar.Template>
                        <ControlTemplate TargetType="ProgressBar">
                            <Border Background="{TemplateBinding Background}" CornerRadius="5" ClipToBounds="True">
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="5">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#A9813F" Offset="0"/>
                                            <GradientStop Color="#E2C486" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                            </Border>
                        </ControlTemplate>
                    </ProgressBar.Template>
                </ProgressBar>
                <Grid Margin="0,12,0,0">
                    <TextBlock x:Name="Percent" Text="0%" Foreground="#D8B878"
                               FontFamily="Consolas" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock Text="下载完成后会校验并自动重启" Foreground="#6F6A60"
                               FontFamily="Microsoft YaHei UI" FontSize="10.5"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>

            <Grid Grid.Row="3" VerticalAlignment="Bottom" Margin="0,14,0,0">
                <TextBlock Text="请保持网络连接" Foreground="#5F5A51"
                           FontFamily="Microsoft YaHei UI" FontSize="10.5" VerticalAlignment="Center"/>
                <Button Content="取消" Width="82" Height="30" HorizontalAlignment="Right"
                        Background="#23262D" Foreground="#CFC6B7" BorderBrush="#4A4032"
                        BorderThickness="1" Cursor="Hand" Click="Cancel_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
